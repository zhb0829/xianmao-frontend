<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.gxu.dao.CollectMapper">
    <resultMap id="BaseResultMap" type="cn.edu.gxu.model.Collect">
        <id column="ID" jdbcType="INTEGER" property="id" />
        <result column="UserID" jdbcType="INTEGER" property="userId" />
        <result column="CommodityID" jdbcType="INTEGER" property="commodityId" />
    </resultMap>

    <sql id="Base_Column_List">
        ID, UserID, CommodityID
    </sql>

    <select id="selectCollect" parameterType="java.lang.Integer" resultType="cn.edu.gxu.model.CommodityInfo">
        select
            b.ID, b.TradeName, b.Price, b.Description, b.Time, b.SellerID, b.ShippingAddress, b.Category, b.Status
        from collect a,commodityinfo b
         where a.UserID = #{userId ,jdbcType = INTEGER} and a.CommodityID=b.ID
    </select>
    <delete id="deleteCollect" parameterType="java.lang.Integer">
        delete from collect
        where collect.UserID = #{userId,jdbcType=INTEGER}  and collect.CommodityID = #{commodityId,jdbcType=INTEGER}
    </delete>
    <insert id="insertCollect" parameterType="java.lang.Integer" useGeneratedKeys="true" >
        INSERT INTO collect (
            UserID,CommodityID
        ) VALUES (
                  #{userId,jdbcType=INTEGER},#{commodityId,jdbcType=INTEGER}
                  )
    </insert>
</mapper>